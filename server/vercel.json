{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "functions": {
    "api/**/*.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/views/:view", "destination": "/api/views/:view" },
    { "source": "/runs/:id", "destination": "/api/runs/:id" },
    { "source": "/inbox", "destination": "/api/inbox" },
    { "source": "/profile", "destination": "/api/profile" },
    { "source": "/documents", "destination": "/api/documents" },
    { "source": "/health", "destination": "/api/health" }
  ]
}
